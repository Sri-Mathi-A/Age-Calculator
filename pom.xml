pipeline {
    agent any
    stages {
        stage('Compile Java') {
            steps {
                sh '''
                    mkdir -p target/classes
                    javac -d target/classes AgeCalculator.java
                    
                    mkdir -p target/classes/static
                    cp index.html target/classes/static/
                    
                    jar cvf target/my-app.jar -C target/classes .
                '''
            }
        }
    }
}
